# Plantilla de las variables de entorno del sistema. Va a git y no lleva
# ningún secreto. El archivo de verdad se llama .env, va en la raíz del
# repositorio (al lado de docker-compose.yml), hay uno por máquina y no va
# a git (.gitignore): se copia este y se completa.
#
# En la PC el .env lo lee Django (settings/base.py y manage.py). En el
# servidor lo lee Compose: se lo pasa a los contenedores db y backend
# (env_file) y de ahí toma la usuaria y la contraseña de la base
# (environment, en docker-compose.yml).
#
# Cada variable dice su valor en desarrollo (la PC, con runserver) y en
# producción (el servidor). La prueba con Docker en la PC (DESPLIEGUE.md)
# usa los de producción, salvo donde dice "Prueba en la PC". "No va"
# quiere decir que en esa máquina la línea se borra. Las líneas traen el
# valor escrito cuando es uno solo y no es secreto.

# Qué settings carga Django: config/settings/desarrollo.py o
# produccion.py. DEBUG no es una variable: cada uno de esos archivos lo fija.
#   Desarrollo: desarrollo
#   Producción: produccion
ENTORNO=

# Clave criptográfica de Django: firma las sesiones y los tokens CSRF.
# Larga, secreta y distinta en cada máquina. Se genera con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (en la PC con el venv; en el servidor con el python3 de Ubuntu). Son 67
# caracteres de letras, números, guion y guion bajo: ninguno que este
# archivo o Compose interpreten de forma especial.
#   Desarrollo y producción: una clave nueva en cada una
SECRET_KEY=

# Los dominios que Django acepta en la cabecera Host, separados por coma.
#   Desarrollo: no va (desarrollo.py acepta localhost solo)
#   Producción: anaporcelana.com.ar,www.anaporcelana.com.ar
#   Prueba en la PC: localhost,127.0.0.1
ALLOWED_HOSTS=

# Los orígenes desde los que se aceptan POST, PUT, PATCH y DELETE, con el
# esquema.
#   Desarrollo: no va (desarrollo.py tiene escrito el de Vite)
#   Producción: https://anaporcelana.com.ar,https://www.anaporcelana.com.ar
#   Prueba en la PC: http://localhost
CSRF_TRUSTED_ORIGINS=

# si: cookies solo por https, redirección a https y HSTS. no: solo para la
# prueba en la PC, donde no hay certificado. Si la variable falta, vale
# si; vacía valdría no, por eso viene escrita.
#   Desarrollo: no va (desarrollo.py no la lee)
#   Producción: si
#   Prueba en la PC: no
HTTPS_ACTIVO=si

# La cuenta de Gmail del emprendimiento, desde la que el sistema manda
# correo (hoy, el enlace para restablecer la contraseña), y su contraseña
# de aplicación (Cuenta de Google → Seguridad → Verificación en dos pasos
# → Contraseñas de aplicaciones): nunca la contraseña de la cuenta. Sin
# las dos, en desarrollo el correo se imprime en la terminal del
# runserver en lugar de mandarse.
#   Desarrollo: no van (o las de producción, para probar un envío real)
#   Producción: ana.porcelanaaaa@gmail.com y su contraseña de aplicación
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# El remitente que ve quien recibe el correo. Va entre comillas porque
# lleva espacios, y la dirección tiene que ser la misma cuenta de Gmail.
#   Desarrollo: no va
#   Producción: "Ana Porcelana <ana.porcelanaaaa@gmail.com>"
DEFAULT_FROM_EMAIL=

# La dirección del sitio, con el esquema y sin barra final: con ella se
# arma el enlace del correo. Sale de acá y no del Host del pedido, que
# cualquiera puede falsificar.
#   Desarrollo: no va (base.py usa http://localhost:5173)
#   Producción: https://anaporcelana.com.ar
#   Prueba en la PC: http://localhost
URL_SITIO=

# La base del contenedor db. La imagen de PostgreSQL la crea con estos
# tres valores la primera vez que arranca, y el backend se conecta con
# la misma usuaria y contraseña: docker-compose.yml se las pasa como
# DB_USER y DB_PASSWORD, así la contraseña se escribe una sola vez.
#   Desarrollo: no va (la base es la del PostgreSQL instalado en la PC)
#   Producción: ana_porcelana, ana_porcelana y una contraseña larga
POSTGRES_DB=ana_porcelana
POSTGRES_USER=ana_porcelana
POSTGRES_PASSWORD=

# La base con la que se conecta Django. Normalmente la misma de
# POSTGRES_DB. Para medir con datos de prueba en el servidor se cambia
# solo esta línea a otra base del mismo contenedor (ver DESPLIEGUE.md).
#   Desarrollo: ana_porcelana (ana_porcelana_prueba para los datos de
#               cargar_datos_prueba)
#   Producción: ana_porcelana
DB_NAME=ana_porcelana

# La usuaria y la contraseña con las que se conecta Django en la PC.
#   Desarrollo: las del PostgreSQL de la PC
#   Producción: no va (docker-compose.yml las toma de POSTGRES_USER y
#               POSTGRES_PASSWORD)
DB_USER=
DB_PASSWORD=

# Dónde escucha la base.
#   Desarrollo: localhost y 5432
#   Producción: db (el nombre del servicio en docker-compose.yml) y 5432
DB_HOST=
DB_PORT=5432
