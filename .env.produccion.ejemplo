# Variables de producción. Copiá este archivo como .env.produccion, al
# lado de docker-compose.yml, y completá lo que está vacío. Compose les
# pasa estas variables a los contenedores db y backend. El archivo real
# no va a git (.gitignore); backend/.env sigue siendo el de desarrollo.
#
# Los valores escritos son los del servidor. Para probar en la PC, usá
# los que dicen las líneas "PC:" en lugar de los del servidor.

# Qué settings carga Django (config/settings/produccion.py). DEBUG no es
# una variable: produccion.py lo fija en False.
ENTORNO=produccion

# Clave criptográfica de Django: firma las sesiones y los tokens CSRF.
# Nueva, larga y secreta; nunca la de desarrollo. Se genera con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (en la PC con el venv; en el servidor con el python3 de Ubuntu). Son 67
# caracteres de letras, números, guion y guion bajo: ninguno que este
# archivo o Compose interpreten de forma especial.
SECRET_KEY=

# Los dominios que Django acepta en la cabecera Host, separados por coma.
# PC: ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS=anaporcelana.com.ar,www.anaporcelana.com.ar

# Los orígenes desde los que se aceptan POST, PUT, PATCH y DELETE, con el
# esquema. PC: CSRF_TRUSTED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=https://anaporcelana.com.ar,https://www.anaporcelana.com.ar

# si: cookies solo por https, redirección a https y HSTS (el servidor).
# no: solo para la prueba en la PC, donde no hay certificado. Si la
# variable falta, vale si.
# PC: HTTPS_ACTIVO=no
HTTPS_ACTIVO=si

# La base de datos. Son dos ternas con los mismos valores porque las leen
# dos programas distintos: POSTGRES_* las lee la imagen de PostgreSQL al
# crear la base la primera vez; DB_* las lee Django para conectarse.
# Tienen que coincidir. Elegí una contraseña larga y escribila en las
# dos. DB_HOST es "db", el nombre del servicio en docker-compose.yml.
POSTGRES_DB=ana_porcelana
POSTGRES_USER=ana_porcelana
POSTGRES_PASSWORD=
DB_NAME=ana_porcelana
DB_USER=ana_porcelana
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
